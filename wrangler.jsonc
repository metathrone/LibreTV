{
  "name": "libretv",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-05-05",
  "compatibility_flags": ["nodejs_compat", "enable_weak_ref"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "tv.rushia.eu.org",
      "custom_domain": true
    }
  ],
  "vars": {
    "SEARCH_MAX_PAGES": "2",
    "DEFAULT_SOURCES": "[{\"name\":\"量子资源\",\"url\":\"https://cj.lziapi.com/api.php/provide/vod\"},{\"name\":\"暴风资源\",\"url\":\"https://bfzyapi.com/api.php/provide/vod\"},{\"name\":\"红牛资源\",\"url\":\"https://www.hongniuzy2.com/api.php/provide/vod\"},{\"name\":\"极速资源\",\"url\":\"https://jszyapi.com/api.php/provide/vod\"},{\"name\":\"新浪资源\",\"url\":\"https://api.xinlangapi.com/xinlangapi.php/provide/vod\"}]",
    "DEFAULT_LIVE_SOURCES": "[{\"name\":\"全国电视·综合 (IPv4)\",\"url\":\"https://live.zbds.top/tv/iptv4.m3u\",\"epg\":\"http://epg.51zmt.top:8000/e.xml\"},{\"name\":\"央卫高清·精选 (全频道)\",\"url\":\"https://raw.githubusercontent.com/wwb521/live/main/tv.m3u\",\"epg\":\"http://epg.51zmt.top:8000/e.xml\"},{\"name\":\"中国电视·自动更新\",\"url\":\"https://raw.githubusercontent.com/hujingguang/ChinaIPTV/main/cnTV_AutoUpdate.m3u8\"},{\"name\":\"央卫超清·IPv6 (备用)\",\"url\":\"https://live.fanmingming.com/tv/m3u/ipv6.m3u\",\"epg\":\"https://live.fanmingming.com/e.xml\"}]"
  }
}
