{
  "name": "libretv",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-05-05",
  "compatibility_flags": ["nodejs_compat", "enable_weak_ref"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "tv.rushia.eu.org",
      "custom_domain": true
    }
  ]
}
