{
  "name": "libretv",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-05-05",
  "compatibility_flags": ["nodejs_compat", "enable_weak_ref"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "tv.rushia.eu.org",
      "custom_domain": true
    }
  ],
  "vars": {
    "DEFAULT_SOURCES": "[{\"name\":\"量子资源\",\"url\":\"https://cj.lziapi.com/api.php/provide/vod\"},{\"name\":\"暴风资源\",\"url\":\"https://bfzyapi.com/api.php/provide/vod\"},{\"name\":\"索尼资源\",\"url\":\"https://suoniapi.com/api.php/provide/vod\"},{\"name\":\"红牛资源\",\"url\":\"https://www.hongniuzy2.com/api.php/provide/vod\"},{\"name\":\"极速资源\",\"url\":\"https://jszyapi.com/api.php/provide/vod\"},{\"name\":\"闪电资源\",\"url\":\"https://sdzyapi.com/api.php/provide/vod\"},{\"name\":\"樱花资源\",\"url\":\"https://m3u8.apiyhzy.com/api.php/provide/vod\"},{\"name\":\"非凡资源\",\"url\":\"http://cj.ffzyapi.com/api.php/provide/vod\"}]",
    "DEFAULT_LIVE_SOURCES": "[{\"name\":\"FanMingMing 央卫高清 (IPv6)\",\"url\":\"https://live.fanmingming.com/tv/m3u/ipv6.m3u\",\"epg\":\"https://live.fanmingming.com/e.xml\"},{\"name\":\"Guovin 电视直播综合\",\"url\":\"https://raw.githubusercontent.com/Guovin/iptv-api/gd/output/result.m3u\",\"epg\":\"http://epg.51zmt.top:8000/e.xml\"},{\"name\":\"YueChan 精选直播\",\"url\":\"https://raw.githubusercontent.com/YueChan/Live/main/IPTV.m3u\",\"epg\":\"http://epg.51zmt.top:8000/e.xml\"},{\"name\":\"IPTV-org 中国频道\",\"url\":\"https://raw.githubusercontent.com/iptv-org/iptv/master/streams/cn.m3u\"}]"
  }
}
